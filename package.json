{
  "name": "effect-foldkit-cloudflare-template",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "alchemy dev",
    "dev:reference": "alchemy dev --stage reference",
    "build": "turbo run build",
    "check": "vp check",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint",
    "typecheck": "tsrs --noEmit -p tsconfig.json && effect-tsrs diagnostics --strict --project tsconfig.json && turbo run typecheck",
    "test": "turbo run test",
    "rename": "node scripts/rename.mjs",
    "deploy": "alchemy deploy --stage prod"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@cloudflare/workers-types": "5.20261116.1",
    "@effect/language-service": "0.87.5",
    "@sentry/rollup-plugin": "11.11.0",
    "@template/rpc": "workspace:*",
    "@types/node": "26.6.6",
    "@yielded/effect-tsrs": "0.2.3",
    "alchemy": "2.0.0-beta.87",
    "effect": "4.1.4",
    "lefthook": "2.2.2",
    "tsrs": "7.1.0-beta.tsrs2",
    "turbo": "2.11.11",
    "vite-plus": "1.7.0",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.0.0"
}
