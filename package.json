{
  "name": "effect-foldkit-cloudflare-template",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install && effect-tsgo patch --skip-missing",
    "dev": "alchemy dev",
    "dev:reference": "alchemy dev --stage reference",
    "build": "turbo run build",
    "check": "vp check",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint",
    "typecheck": "tsc --noEmit -p tsconfig.json && turbo run typecheck",
    "test": "turbo run test",
    "deploy": "alchemy deploy --stage prod"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261008.1",
    "@effect/language-service": "0.87.5",
    "@effect/tsgo": "0.53.3",
    "@template/rpc": "workspace:*",
    "@types/node": "26.6.4",
    "alchemy": "2.0.0-beta.81",
    "effect": "4.0.0",
    "lefthook": "2.2.0",
    "turbo": "2.11.7",
    "typescript": "7.0.2",
    "vite-plus": "1.1.0",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@12.0.0"
}
