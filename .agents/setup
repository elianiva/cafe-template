#!/usr/bin/env bash
set -euo pipefail

step() {
	printf '\n==> %s\n' "$1"
}

step 'Check Node.js version'
node --eval '
const [major] = process.versions.node.split(".").map(Number)
if (major < 26) {
  console.error(`Node.js ${process.versions.node} is too old; this repo requires 26 or newer.`)
  process.exit(1)
}
console.log(`Node.js ${process.versions.node}`)
'

step 'Ensure pnpm 12.0.0'
current_pnpm="$(pnpm --version 2>/dev/null || true)"
if [[ "$current_pnpm" != '12.0.0' ]]; then
  npm install --global pnpm@12.0.0
fi
pnpm --version

step 'Install workspace dependencies'
pnpm install --frozen-lockfile

step 'Patch oxlint to use the Effect rules'
pnpm exec effect-tsrs patch --oxlint
